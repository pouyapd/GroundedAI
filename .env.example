# Copy to .env and adjust. Never commit .env.
# All settings use the GROUNDEDAI_ prefix; backend/groundedai/core/config.py lists every option.
# Comments are on their own lines on purpose: some .env parsers keep inline comments in values.

# --- Runtime -----------------------------------------------------------------
# development | test | production
GROUNDEDAI_ENV=development
GROUNDEDAI_LOG_LEVEL=INFO
GROUNDEDAI_LOG_JSON=true

# --- Security ----------------------------------------------------------------
# Required when GROUNDEDAI_ENV=production (at least 24 characters). When set, /api/v1
# endpoints except health, readiness and system status need the X-API-Key header.
GROUNDEDAI_API_KEY=
GROUNDEDAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROUNDEDAI_RATE_LIMIT_ENABLED=true

# --- Storage -----------------------------------------------------------------
# Default: SQLite in ./data. Docker Compose builds a PostgreSQL URL from POSTGRES_PASSWORD.
# GROUNDEDAI_DATABASE_URL=postgresql+psycopg://groundedai:change-me@localhost:5432/groundedai
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Embeddings --------------------------------------------------------------
# hashing (no model, default) | sentence-transformers (needs the [ml] extra) | ollama
GROUNDEDAI_EMBEDDING_PROVIDER=hashing
# GROUNDEDAI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GROUNDEDAI_EMBEDDING_DIM=384
# Never download Hugging Face models implicitly (use scripts/download_models.py).
GROUNDEDAI_HF_OFFLINE=true

# --- Retrieval ---------------------------------------------------------------
# lexical | dense | hybrid
GROUNDEDAI_RETRIEVAL_MODE=hybrid
# rrf | weighted
GROUNDEDAI_FUSION=rrf
GROUNDEDAI_TOP_K=5
# none | cross-encoder
GROUNDEDAI_RERANKER=none

# --- Generation --------------------------------------------------------------
# extractive-demo (no model, default) | ollama | huggingface-local
GROUNDEDAI_GENERATION_PROVIDER=extractive-demo
GROUNDEDAI_OLLAMA_BASE_URL=http://localhost:11434
GROUNDEDAI_OLLAMA_MODEL=qwen2.5:1.5b
# GROUNDEDAI_HF_GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct
GROUNDEDAI_GENERATION_TIMEOUT_S=120
GROUNDEDAI_MAX_CONCURRENT_GENERATIONS=2

# --- Answer checks -------------------------------------------------------------
# answer-v2 (default) | answer-v1 (reproduces the reports published before 2026-10-13)
# GROUNDEDAI_PROMPT_VERSION=answer-v2
# disagreement-v1 (default) | figures-v1 (the check published on 2026-10-13)
# GROUNDEDAI_CONFLICT_CHECK=disagreement-v1
# label (default: return it marked unverified) | withhold (return insufficient_evidence)
# when no statement of an answer could be matched to a retrieved passage
# GROUNDEDAI_UNVERIFIED_ANSWERS=label

# --- Docker build ------------------------------------------------------------
# true adds sentence-transformers and CPU-only PyTorch to the image (about 1 GB more).
INSTALL_ML=false
