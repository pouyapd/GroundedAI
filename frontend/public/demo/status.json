{
 "version": "0.1.0",
 "environment": "development",
 "demo_mode": true,
 "auth_required": false,
 "database_backend": "sqlite",
 "embedding": {
  "provider": "sentence-transformers",
  "model": "sentence-transformers:BAAI/bge-small-en-v1.5",
  "is_llm": null,
  "available": true,
  "detail": "Loaded."
 },
 "generation": {
  "provider": "extractive-demo",
  "model": "extractive-demo-v1",
