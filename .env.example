# Copy to .env and adjust. Never commit .env.
# All settings use the GROUNDEDAI_ prefix; backend/groundedai/core/config.py lists every option.
# Comments are on their own lines on purpose: some .env parsers keep inline comments in values.

# --- Runtime -----------------------------------------------------------------
# development | test | production
GROUNDEDAI_ENV=development
GROUNDEDAI_LOG_LEVEL=INFO
GROUNDEDAI_LOG_JSON=true

# --- Security ----------------------------------------------------------------
# Required when GROUNDEDAI_ENV=production (at least 24 characters). When set, /api/v1
# endpoints except health, readiness and system status need the X-API-Key header.
GROUNDEDAI_API_KEY=
GROUNDEDAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROUNDEDAI_RATE_LIMIT_ENABLED=true

# --- Storage -----------------------------------------------------------------
# Default: SQLite in ./data. Docker Compose builds a PostgreSQL URL from POSTGRES_PASSWORD.
# GROUNDEDAI_DATABASE_URL=postgresql+psycopg://groundedai:change-me@localhost:5432/groundedai
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Embeddings --------------------------------------------------------------
# hashing (no model, default) | sentence-transformers (needs the [ml] extra) | ollama
GROUNDEDAI_EMBEDDING_PROVIDER=hashing
# GROUNDEDAI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GROUNDEDAI_EMBEDDING_DIM=384
# Never download Hugging Face models implicitly (use scripts/download_models.py).
GROUNDEDAI_HF_OFFLINE=true

# --- Documents ---------------------------------------------------------------
# v2 (default: expand ligatures, join words hyphenated at line breaks, remove running
# headers/footers and page numbers) | v1 (text as extracted, the behaviour before 2026-11).
# Documents keep the version they were indexed with; after changing it, re-index them
# (Documents page, POST /api/v1/documents/reindex or `groundedai reindex`).
# GROUNDEDAI_TEXT_CLEANUP=v2

# --- Retrieval ---------------------------------------------------------------
# lexical | dense | hybrid
GROUNDEDAI_RETRIEVAL_MODE=hybrid
# rrf | weighted
GROUNDEDAI_FUSION=rrf
GROUNDEDAI_TOP_K=5
# none | cross-encoder
GROUNDEDAI_RERANKER=none

# --- Generation --------------------------------------------------------------
# extractive-demo (no model, default) | ollama | huggingface-local
GROUNDEDAI_GENERATION_PROVIDER=extractive-demo
# Extractive generator: prefix (default: also other forms of a word) | exact (same words only)
# GROUNDEDAI_EXTRACTIVE_MATCHING=prefix
GROUNDEDAI_OLLAMA_BASE_URL=http://localhost:11434
GROUNDEDAI_OLLAMA_MODEL=qwen2.5:1.5b
# GROUNDEDAI_HF_GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct
GROUNDEDAI_GENERATION_TIMEOUT_S=120
GROUNDEDAI_MAX_CONCURRENT_GENERATIONS=2

# --- Answer checks -------------------------------------------------------------
# answer-v2 (default) | answer-v1 (reproduces the reports published before 2026-10-13)
# GROUNDEDAI_PROMPT_VERSION=answer-v2
# disagreement-v3 (default since 2026-11-13: also compares two editions of one document) |
# disagreement-v1 | disagreement-v2 | figures-v1 (the check published on 2026-10-13)
# GROUNDEDAI_CONFLICT_CHECK=disagreement-v3
# claims-v1 (default) | claims-v2 (opt-in: support from the few sentences that carry each
# statement, equivalent wordings, separate evidence/citation/relevance verdicts and a warning
# when an answer does not mention a conflict). See docs/RELIABILITY_V2.md.
# GROUNDEDAI_CLAIM_CHECK=claims-v1
# off (default) | on: the added-detail rule (a matching statement with two or more consecutive
# words found in no passage becomes partial). Optional: it did not help on the protected test
# claims. See docs/RELIABILITY_V3.md, section B.
# GROUNDEDAI_CLAIM_DETAIL_CHECK=off
# label (default: return it marked unverified) | withhold (return insufficient_evidence)
# when no statement of an answer could be matched to a retrieved passage
# GROUNDEDAI_UNVERIFIED_ANSWERS=label

# --- Input limits --------------------------------------------------------------
# Defaults: 10 MB per upload, 300 pages per PDF. The free cloud deployment uses 5 MB and 100.
# GROUNDEDAI_MAX_UPLOAD_BYTES=10485760
# GROUNDEDAI_MAX_PDF_PAGES=300

# --- Cloud deployment (Render + Neon), see docs/DEPLOYMENT.md section 5 ----------
# Set these in the host's secret manager, never in a committed file. Placeholders only.
# GROUNDEDAI_ENV=production
# GROUNDEDAI_API_KEY=<random value, at least 24 characters>
# GROUNDEDAI_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# GROUNDEDAI_CORS_ORIGINS=https://<your-service>.onrender.com
# PORT=8000

# --- Docker build ------------------------------------------------------------
# true adds sentence-transformers and CPU-only PyTorch to the image (about 1 GB more).
INSTALL_ML=false
