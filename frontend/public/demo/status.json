  "model": null,
  "is_llm": null,
  "available": null,
  "detail": "Disabled."
 },
 "retrieval_defaults": {
  "mode": "hybrid",
  "fusion": "rrf",
  "top_k": 5,
  "candidate_k": 20,
  "rrf_k": 60,
  "hybrid_alpha": 0.5,
  "chunk_size": 400,
  "chunk_overlap": 60
 },
 "limits": {
  "max_upload_bytes": 10485760,
